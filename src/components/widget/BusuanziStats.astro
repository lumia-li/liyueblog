---
---
<section id="busuanzi-stats-card" class="site-state card-base mt-4 p-4 transition-swup-fade onload-animation">
	<div
		class="font-bold transition text-lg text-neutral-900 dark:text-neutral-100 relative ml-8 mb-3
        before:w-1 before:h-4 before:rounded-md before:bg-[var(--primary)]
        before:absolute before:left-[-16px] before:top-[5.5px]"
	>
		访问统计
	</div>

	<!--
		整句必须渲染成【单个文本节点】才能正确翻译：
		翻译引擎按文本节点逐个翻译，中间夹 <span> 会被拆成
		「您是本站的第」+「个小伙伴」两段，译文会失去语义。
		初始占位符不含文字字符，避免引擎在真实数字到位前就把父节点标记成「已翻译」，
		导致后面写入的整句被跳过；数字到位后由脚本整体替换这句文本。
	-->
	<p id="busuanzi_friend_sentence" class="text-sm text-50">--</p>

	<div class="mt-3 rounded-xl border border-dashed border-[var(--line-divider)] px-3 py-2">
		<div class="flex min-w-0 flex-wrap items-center justify-between gap-x-3 gap-y-1 py-1.5 text-sm">
			<span class="min-w-0 text-50">本站总访问量</span>
			<span class="ml-auto min-w-0 break-all text-right text-75 font-semibold" data-no-translate><span id="busuanzi_site_pv">加载中...</span> 次</span>
		</div>
		<div class="flex min-w-0 flex-wrap items-center justify-between gap-x-3 gap-y-1 py-1.5 text-sm">
			<span class="min-w-0 text-50">今日总访问量</span>
			<span class="ml-auto min-w-0 break-all text-right text-75 font-semibold" data-no-translate><span id="busuanzi_today_pv">加载中...</span> 次</span>
		</div>
		<div class="flex min-w-0 flex-wrap items-center justify-between gap-x-3 gap-y-1 py-1.5 text-sm">
			<span class="min-w-0 text-50">今日总访客数</span>
			<span class="ml-auto min-w-0 break-all text-right text-75 font-semibold" data-no-translate><span id="busuanzi_today_uv">加载中...</span> 人</span>
		</div>
		<div class="flex min-w-0 flex-wrap items-center justify-between gap-x-3 gap-y-1 py-1.5 text-sm">
			<span class="min-w-0 text-50">本站总访客数</span>
			<span class="ml-auto min-w-0 break-all text-right text-75 font-semibold" data-no-translate><span id="busuanzi_site_uv">加载中...</span> 人</span>
		</div>
		<div class="flex min-w-0 flex-wrap items-center justify-between gap-x-3 gap-y-1 py-1.5 text-sm">
			<span class="min-w-0 text-50">本页总浏览量</span>
			<span class="ml-auto min-w-0 break-all text-right text-75 font-semibold" data-no-translate><span id="busuanzi_page_pv">加载中...</span> 次</span>
		</div>
		<div class="flex min-w-0 flex-wrap items-center justify-between gap-x-3 gap-y-1 py-1.5 text-sm">
			<span class="min-w-0 text-50">本页总访客数</span>
			<span class="ml-auto min-w-0 break-all text-right text-75 font-semibold" data-no-translate><span id="busuanzi_page_uv">加载中...</span> 人</span>
		</div>
	</div>
</section>

<script is:inline>
	(() => {
		const SCRIPT_ID = "busuanzi-counter-script";
		const SCRIPT_SRC = "https://cdn.busuanzi.cc/busuanzi/3.6.9/busuanzi.min.js";
		const CARD_ID = "busuanzi-stats-card";

		const setTextSafely = (id, value) => {
			const el = document.getElementById(id);
			if (!el) return;
			el.textContent = value;
		};

		const setFallbackValues = () => {
			[
				"busuanzi_site_pv",
				"busuanzi_today_pv",
				"busuanzi_today_uv",
				"busuanzi_site_uv",
				"busuanzi_page_pv",
				"busuanzi_page_uv",
			].forEach((id) => setTextSafely(id, "--"));
		};

		// 整句写入同一个文本节点，保证翻译引擎能拿到完整句子
		const syncFriendCounter = () => {
			const siteUv = document.getElementById("busuanzi_site_uv");
			const sentence = document.getElementById("busuanzi_friend_sentence");
			if (!siteUv || !sentence) return;
			const value = siteUv.textContent?.trim();
			if (!value || value === "加载中...") return;
			// 同一个值只写一次：重复写入会覆盖掉引擎写回的译文
			if (sentence.dataset.value === value) return;
			sentence.dataset.value = value;
			// 引擎会给「已翻译过」的元素打上 data-i18n-applied 标记，
			// 带着这个标记写入的新句子会被当成已翻译而跳过，因此重写前先清掉它，
			// 让引擎把新写进去的整句当作新内容重新翻译。
			sentence.removeAttribute("data-i18n-applied");
			sentence.textContent = `您是本站的第 ${value} 个小伙伴`;
		};

		const bindFriendObserver = () => {
			const siteUv = document.getElementById("busuanzi_site_uv");
			if (!siteUv) return;

			const prevObserver = window.__busuanziSiteUvObserver;
			if (prevObserver && typeof prevObserver.disconnect === "function") {
				prevObserver.disconnect();
			}

			const observer = new MutationObserver(syncFriendCounter);
			observer.observe(siteUv, {
				childList: true,
				subtree: true,
				characterData: true,
			});
			window.__busuanziSiteUvObserver = observer;
		};

		const loadBusuanzi = () => {
			window.busuanziRequestSent = false;

			const oldScript = document.getElementById(SCRIPT_ID);
			if (oldScript) oldScript.remove();

			const script = document.createElement("script");
			script.id = SCRIPT_ID;
			script.src = SCRIPT_SRC;
			script.defer = true;
			script.onload = () => setTimeout(syncFriendCounter, 120);
			script.onerror = () => setFallbackValues();
			document.head.appendChild(script);
		};

		const refreshBusuanzi = () => {
			const card = document.getElementById(CARD_ID);
			if (!card) return;

			loadBusuanzi();
			bindFriendObserver();
			setTimeout(syncFriendCounter, 180);
		};

		const bindSwupHook = () => {
			if (!window.swup?.hooks || window.__busuanziSwupHooked) return;
			window.__busuanziSwupHooked = true;
			window.swup.hooks.on("page:view", refreshBusuanzi);
		};

		refreshBusuanzi();
		if (window.swup?.hooks) {
			bindSwupHook();
		} else {
			document.addEventListener("swup:enable", bindSwupHook, { once: true });
		}
	})();
</script>
