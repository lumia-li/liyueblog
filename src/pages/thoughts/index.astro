---
import ThoughtCard from "@components/ThoughtCard.astro";
import ThoughtInfiniteScroll from "@components/ThoughtInfiniteScroll.svelte";
import { THOUGHTS_BATCH_SIZE } from "@constants/constants";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedThoughts } from "@utils/thoughts-utils";
import { getThoughtUrlBySlug, url } from "@utils/url-utils";

const allThoughts = await getSortedThoughts();

// 首屏由服务端渲染前 N 条，保证无 JS / 搜索引擎也能看到内容
const firstBatch = allThoughts.slice(0, THOUGHTS_BATCH_SIZE);
---

<MainGridLayout title="随笔" description="碎碎念与随笔">
	<div class="flex items-center gap-3 mb-4 onload-animation">
		<div class="w-1 h-6 md:h-7 rounded-md bg-[var(--primary)]"></div>
		<h1 class="text-2xl md:text-3xl font-bold text-white/90 dark:text-black/90">随笔</h1>
	</div>
	<div class="flex flex-col gap-4 mb-4">
		{
			firstBatch.map((t, i) => (
				<ThoughtCard
					slug={t.slug}
					url={getThoughtUrlBySlug(t.slug)}
					title={t.data.title ?? ""}
					published={t.data.published}
					description={t.data.description ?? ""}
					class:list="onload-animation"
					style={`animation-delay: calc(var(--content-delay) + ${i * 50}ms);`}
				/>
			))
		}

		<ThoughtInfiniteScroll
			client:only="svelte"
			startIndex={firstBatch.length}
			total={allThoughts.length}
			feedUrl={url("/thoughts/feed.json")}
		/>
	</div>
</MainGridLayout>
