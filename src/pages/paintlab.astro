---
// Paintlab：主题内的缩略画廊（套用博客 Layout，页头/侧边栏/主题样式一致）
// 内容区：上传区 + 作品信息/按钮 → 标题栏 → 缩略图画廊；大图点击后弹层查看
import MainGridLayout from "../layouts/MainGridLayout.astro";
---

<MainGridLayout
	title="Paintlab · 一笔一笔"
	description="把任意图片转成一笔一笔的绘制过程，支持多图按上传顺序连续绘制。"
>
	<div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative">
		<div class="card-base z-10 px-6 py-5 relative w-full paintlab-root" id="paintlab-app">
			<div class="flex flex-wrap items-start justify-between gap-4">
				<div class="min-w-0">
					<div class="font-bold text-xl paintlab-title-shine">Paintlab</div>
					<p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">
						把图片拖进下方区域，按上传顺序逐张画出来；点击任意缩略图看大图。
					</p>
				</div>
			</div>

			<!-- 工具条：上传区 | 统计 | 操作按钮 -->
			<div class="paintlab-toolbar">
				<div
					id="paintlab-drop"
					class="paintlab-drop"
					role="button"
					tabindex="0"
					aria-label="上传图片"
				>
					<svg
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="paintlab-drop-icon"
					>
						<rect x="3" y="4" width="18" height="16" rx="2.5"></rect>
						<circle cx="8.5" cy="9.5" r="1.6"></circle>
						<path d="M3.5 17.5l4.8-4.6a1.8 1.8 0 0 1 2.5 0l3.1 3 1.7-1.6a1.8 1.8 0 0 1 2.5 0l2.4 2.3"
						></path>
					</svg>
					<span class="paintlab-drop-body">
						<span class="paintlab-drop-title">拖入图片 / 点击选择</span>
						<span class="paintlab-drop-sub">PNG / JPG / WEBP / GIF · 最多 12 张 · 单张 ≤ 20MB</span>
					</span>
				</div>

				<div class="paintlab-stats">
					<span class="paintlab-stat">
						<span id="paintlab-count-imgs" class="paintlab-stat-num">0</span>
						<span class="paintlab-stat-unit">张</span>
					</span>
					<span class="paintlab-stat">
						<span id="paintlab-count-strokes" class="paintlab-stat-num">0</span>
						<span class="paintlab-stat-unit">笔</span>
					</span>
				</div>

				<div class="paintlab-actions">
					<button type="button" id="paintlab-replay" class="paintlab-btn paintlab-btn-primary" disabled>
						全部重播
					</button>
					<button type="button" id="paintlab-clear" class="paintlab-btn" disabled>
						清空
					</button>
				</div>
			</div>

			<!-- 说明 + 状态 -->
			<div class="paintlab-foot">
				<p id="paintlab-caption" class="paintlab-caption">
					按上传顺序逐张画出来，点击任意图片可以看大图重播
				</p>
				<div class="paintlab-foot-right">
					<span id="paintlab-state" class="paintlab-foot-state">等待上传</span>
					<span class="paintlab-foot-dot" aria-hidden="true"></span>
					<span id="paintlab-save" class="paintlab-save">数据保存在本机浏览器</span>
				</div>
			</div>

			<!-- 画廊 -->
			<div id="paintlab-gallery" class="paintlab-gallery" hidden></div>
			<div id="paintlab-empty" class="paintlab-empty">
				还没有图片，上传后会在这里按顺序逐张绘制
			</div>

			<input
				id="paintlab-file"
				type="file"
				accept="image/png,image/jpeg,image/webp,image/gif"
				multiple
				hidden
			/>

			<!-- 大图弹层 -->
			<div id="paintlab-lightbox" hidden>
				<div class="paintlab-lb-inner">
					<div id="paintlab-lb-stage" class="paintlab-lb-stage" title="点击重新播放">
						<canvas id="paintlab-lb-canvas"></canvas>
						<img id="paintlab-lb-image" class="paintlab-lb-ref" alt="原图对照" />
					</div>
					<div class="paintlab-lb-bar">
						<button type="button" id="paintlab-lb-play" class="paintlab-btn">⏸ 暂停</button>
						<input id="paintlab-lb-seek" class="paintlab-lb-seek" type="range" min="0" max="10000" value="0" aria-label="绘制进度" />
						<span id="paintlab-lb-time" class="paintlab-lb-time">0:00 / 0:00</span>
						<select id="paintlab-lb-speed" class="paintlab-speed" aria-label="播放速度">
							<option value="0.5">0.5×</option>
							<option value="1">1×</option>
							<option value="2" selected>2×</option>
							<option value="4">4×</option>
							<option value="8">8×</option>
						</select>
						<button type="button" id="paintlab-lb-cmp" class="paintlab-btn">对照原图</button>
						<button type="button" id="paintlab-lb-replay" class="paintlab-btn">重播</button>
						<button type="button" id="paintlab-lb-close" class="paintlab-btn">关闭</button>
					</div>
					<div id="paintlab-lb-info" class="paintlab-lb-info"></div>
				</div>
			</div>
		</div>
	</div>
</MainGridLayout>

<script>
	import "../scripts/paintlab/app";
</script>

<style is:global>
	/* 主题的 body 在深色模式下没有统一文字色，组件内依赖 inherit 的元素会变成黑色，
	   所以在根节点显式给一套基础色，整棵子树继承 */
	.paintlab-root {
		color: rgba(0, 0, 0, 0.85);
	}

	:root.dark .paintlab-root {
		color: rgba(255, 255, 255, 0.9);
	}

	/* 全屏绘制时隐藏灯笼等页面装饰，避免挡住画面 */
	body.paintlab-lb-open .lantern-container,
	body.paintlab-lb-open .lantern-toggle-container {
		display: none !important;
	}

	/* 页面标题：彩色径向流光（浅色深彩、深色亮彩），单向流动 */
	.paintlab-title-shine {
		display: inline-block;
		/* 与深色同一套色相（金 → 粉 → 蓝），只把明度压深 */
		background-image: radial-gradient(
			circle at 50% 50%,
			#0b1220 0%,
			#a16207 26%,
			#be185d 46%,
			#1d4ed8 62%,
			#0b1220 100%
		);
		background-size: 200% 200%;
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
		color: transparent;
		animation: paintlab-title-shine 3s linear infinite;
	}
	:root.dark .paintlab-title-shine {
		background-image: radial-gradient(
			circle at 50% 50%,
			#ffffff 0%,
			#ffd166 26%,
			#ff7ac6 46%,
			#7cc4ff 62%,
			#ffffff 100%
		);
	}

	@keyframes paintlab-title-shine {
		from {
			background-position: 0% 50%;
		}
		to {
			background-position: 200% 50%;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.paintlab-title-shine {
			animation: none;
		}
	}

	/* 工具条：上传区 | 统计 | 操作 */
	.paintlab-toolbar {
		margin-top: 18px;
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto auto;
		align-items: stretch;
		gap: 12px;
	}

	.paintlab-drop {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 12px;
		min-height: 84px;
		padding: 14px 18px;
		border: 1.5px dashed var(--line-divider);
		border-radius: 14px;
		cursor: pointer;
		color: rgba(0, 0, 0, 0.55);
		transition:
			border-color 0.2s,
			background 0.2s,
			color 0.2s;
	}
	:root.dark .paintlab-drop {
		color: rgba(255, 255, 255, 0.6);
	}
	.paintlab-drop:hover,
	.paintlab-drop.is-over {
		border-color: var(--primary);
		background: color-mix(in srgb, var(--primary) 7%, transparent);
	}
	.paintlab-drop-icon {
		flex: 0 0 auto;
		width: 22px;
		height: 22px;
		opacity: 0.75;
	}
	.paintlab-drop-body {
		display: flex;
		flex-direction: column;
		gap: 5px;
		min-width: 0;
	}
	.paintlab-drop-title {
		font-size: 13px;
		font-weight: 600;
		color: rgba(0, 0, 0, 0.85);
	}
	:root.dark .paintlab-drop-title {
		color: rgba(255, 255, 255, 0.92);
	}
	.paintlab-drop-sub {
		font-size: 11px;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	/* 统计：两项竖排，左右细线分隔 */
	.paintlab-stats {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 3px;
		padding: 0 20px;
		border-left: 1px solid var(--line-divider);
		border-right: 1px solid var(--line-divider);
	}
	.paintlab-stat {
		display: flex;
		align-items: baseline;
		gap: 3px;
		white-space: nowrap;
	}
	.paintlab-stat-num {
		font-size: 19px;
		font-weight: 600;
		line-height: 1.1;
		font-variant-numeric: tabular-nums;
	}
	.paintlab-stat-unit {
		font-size: 11px;
		opacity: 0.62;
	}

	/* 操作按钮 */
	.paintlab-actions {
		display: flex;
		align-items: center;
		gap: 8px;
	}
	.paintlab-btn {
		height: 38px;
		padding: 0 18px;
		border-radius: 10px;
		border: 1px solid var(--line-divider);
		background: color-mix(in srgb, var(--btn-regular-bg) 85%, transparent);
		color: inherit;
		font-size: 13px;
		font-weight: 500;
		white-space: nowrap;
		cursor: pointer;
		transition:
			background 0.16s,
			border-color 0.16s,
			color 0.16s,
			opacity 0.16s;
	}
	.paintlab-btn:hover:not(:disabled) {
		border-color: var(--primary);
		color: var(--primary);
		background: color-mix(in srgb, var(--primary) 10%, var(--btn-regular-bg));
	}
	.paintlab-btn-primary {
		border-color: color-mix(in srgb, var(--primary) 45%, transparent);
		background: color-mix(in srgb, var(--primary) 14%, var(--btn-regular-bg));
		color: var(--primary);
		font-weight: 600;
	}
	.paintlab-btn-primary:hover:not(:disabled) {
		background: color-mix(in srgb, var(--primary) 22%, var(--btn-regular-bg));
	}
	.paintlab-btn:disabled {
		opacity: 0.4;
		cursor: not-allowed;
	}
	/* 二次确认态：清空按钮变红 */
	.paintlab-btn.is-confirm {
		border-color: rgba(214, 74, 74, 0.75);
		background: rgba(214, 74, 74, 0.14);
		color: #d64545;
	}
	:root.dark .paintlab-btn.is-confirm {
		border-color: rgba(255, 138, 138, 0.6);
		color: #ff8a8a;
	}
	.paintlab-btn.is-confirm:hover:not(:disabled) {
		background: rgba(214, 74, 74, 0.2);
		border-color: rgba(214, 74, 74, 0.9);
		color: #d64545;
	}
	:root.dark .paintlab-btn.is-confirm:hover:not(:disabled) {
		color: #ff8a8a;
	}

	/* 说明 + 状态行 */
	.paintlab-foot {
		margin-top: 12px;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 6px 14px;
	}
	.paintlab-foot-right {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 11px;
		white-space: nowrap;
	}
	.paintlab-foot-state {
		color: rgba(0, 0, 0, 0.62);
	}
	:root.dark .paintlab-foot-state {
		color: rgba(255, 255, 255, 0.68);
	}
	.paintlab-foot-dot {
		width: 3px;
		height: 3px;
		border-radius: 50%;
		background: currentColor;
		opacity: 0.3;
	}

	.paintlab-caption {
		flex: 1 1 auto;
		min-width: 0;
		margin: 0;
		font-size: 13px;
		line-height: 1.6;
		color: rgba(0, 0, 0, 0.6);
	}
	:root.dark .paintlab-caption {
		color: rgba(255, 255, 255, 0.64);
	}

	/* 本地保存状态提示 */
	.paintlab-save {
		font-size: 11px;
		color: rgba(0, 0, 0, 0.45);
		white-space: nowrap;
	}
	:root.dark .paintlab-save {
		color: rgba(255, 255, 255, 0.5);
	}
	.paintlab-save[data-state="saved"] {
		color: #3f9e6b;
	}
	:root.dark .paintlab-save[data-state="saved"] {
		color: #6fcf97;
	}
	.paintlab-save[data-state="error"] {
		color: #c0392b;
	}
	:root.dark .paintlab-save[data-state="error"] {
		color: #ff8a8a;
	}

	/* 瀑布流：卡片按最短列分配，每列独立纵向排列，图片保持自身比例 */
	.paintlab-gallery {
		margin-top: 16px;
		display: flex;
		align-items: flex-start;
		gap: 14px;
	}
	.paintlab-col {
		flex: 1 1 0;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 14px;
	}

	/* 所有缩略图统一 16:10 容器 + 图片等比居中，显示区域完全一致 */
	.paintlab-card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 10px;
		border: 1px solid var(--line-divider);
		border-radius: 14px;
		background: transparent;
		color: inherit;
		text-align: left;
		cursor: pointer;
		transition: border-color 0.18s, background 0.18s, transform 0.18s;
	}
	.paintlab-card:focus-visible {
		outline: 2px solid var(--primary);
		outline-offset: 2px;
	}

	/* 删除按钮：默认透明不可点，鼠标靠近（或键盘聚焦）才出现 */
	.paintlab-del {
		position: absolute;
		top: 14px;
		right: 14px;
		z-index: 3;
		height: 24px;
		min-width: 24px;
		padding: 0 6px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 7px;
		border: 1px solid rgba(255, 255, 255, 0.22);
		background: rgba(12, 14, 18, 0.74);
		color: #fff;
		font-size: 14px;
		line-height: 1;
		cursor: pointer;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.16s, background 0.16s, transform 0.16s;
		backdrop-filter: blur(4px);
	}
	.paintlab-card:hover .paintlab-del,
	.paintlab-card:focus-within .paintlab-del {
		opacity: 1;
		pointer-events: auto;
	}
	.paintlab-del:hover {
		background: rgba(214, 74, 74, 0.92);
		transform: scale(1.06);
	}
	.paintlab-del.is-confirm {
		opacity: 1;
		pointer-events: auto;
		background: rgba(214, 74, 74, 0.95);
		font-size: 11px;
		padding: 0 8px;
	}
	/* 触屏设备没有 hover，直接常显 */
	@media (hover: none) {
		.paintlab-del {
			opacity: 1;
			pointer-events: auto;
		}
	}
	.paintlab-card:hover {
		border-color: var(--primary);
		transform: translateY(-1px);
	}
	.paintlab-card.paintlab-active {
		border-color: var(--primary);
		box-shadow: 0 0 0 1px var(--primary);
	}
	.paintlab-thumb {
		position: relative;
		display: block;
		width: 100%;
		/* 分析完成后由 JS 改成图片真实比例；这里只是未分析前的占位 */
		aspect-ratio: 16 / 10;
		background: #fffdf9;
		border-radius: 10px;
		overflow: hidden;
	}
	.paintlab-thumb canvas {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
	}
	.paintlab-thumb-hint {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		background: #fffdf9;
		color: #9aa3b0;
		font-size: 12px;
	}
	.paintlab-thumb-hint[hidden] {
		display: none;
	}
	.paintlab-meta {
		display: flex;
		align-items: center;
		gap: 8px;
		min-width: 0;
	}
	.paintlab-name {
		font-size: 12px;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		flex: 1 1 auto;
		/* 允许被压缩到任意宽度，靠省略号收尾，绝不挤占右侧状态区 */
		min-width: 0;
	}
	.paintlab-sub {
		font-size: 11px;
		opacity: 0.72;
		white-space: nowrap;
	}
	.paintlab-tag {
		font-size: 11px;
		opacity: 0.72;
		white-space: nowrap;
		flex: 0 0 auto;
	}
	.paintlab-tag[data-state="playing"] {
		color: var(--primary);
		opacity: 1;
	}
	.paintlab-tag[data-state="done"] {
		color: #6fcf97;
		opacity: 1;
	}

	/* 状态行：文字 + 细进度条 + 完成对号；宽度固定，不被文件名挤压 */
	.paintlab-status {
		display: flex;
		align-items: center;
		gap: 8px;
		min-height: 16px;
		flex: 0 0 auto;
		white-space: nowrap;
	}
	.paintlab-meter {
		position: relative;
		display: block;
		width: 44px;
		height: 3px;
		border-radius: 2px;
		background: var(--line-divider);
		overflow: hidden;
		flex: 0 0 auto;
	}
	.paintlab-meter[hidden] {
		display: none;
	}
	.paintlab-meter i {
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		display: block;
		width: 0;
		background: var(--primary);
		border-radius: 2px;
		transition: width 0.12s linear;
	}
	/* 画完：进度条向右收回 */
	.paintlab-meter.is-collapsing i {
		transform-origin: right center;
		animation: paintlab-meter-out 0.42s cubic-bezier(0.4, 0, 0.2, 1) forwards;
	}
	@keyframes paintlab-meter-out {
		0% {
			transform: scaleX(1);
		}
		100% {
			transform: scaleX(0);
		}
	}

	.paintlab-check {
		display: none;
		width: 16px;
		height: 16px;
		flex: 0 0 auto;
	}
	.paintlab-check.is-visible {
		display: inline-flex;
	}
	.paintlab-check svg {
		width: 16px;
		height: 16px;
	}
	.paintlab-check circle {
		fill: none;
		stroke: #6fcf97;
		stroke-width: 2;
		stroke-dasharray: 63;
		stroke-dashoffset: 63;
	}
	.paintlab-check path {
		fill: none;
		stroke: #6fcf97;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-dasharray: 24;
		stroke-dashoffset: 24;
	}
	.paintlab-check.is-playing circle {
		animation: paintlab-check-circle 0.45s ease forwards;
	}
	.paintlab-check.is-playing path {
		animation: paintlab-check-tick 0.35s ease 0.3s forwards;
	}
	/* 常驻态（刷新恢复或动画结束）：直接显示完整对号 */
	.paintlab-check.is-visible:not(.is-playing) circle,
	.paintlab-check.is-visible:not(.is-playing) path {
		stroke-dashoffset: 0;
	}
	@keyframes paintlab-check-circle {
		to {
			stroke-dashoffset: 0;
		}
	}
	@keyframes paintlab-check-tick {
		to {
			stroke-dashoffset: 0;
		}
	}

	.paintlab-empty {
		margin-top: 16px;
		padding: 42px 24px;
		border: 1.5px dashed var(--line-divider);
		border-radius: 14px;
		text-align: center;
		font-size: 12px;
		opacity: 0.65;
	}
	.paintlab-empty[hidden] {
		display: none;
	}

	#paintlab-lightbox {
		position: fixed;
		inset: 0;
		z-index: 120;
		display: none;
		align-items: center;
		justify-content: center;
		padding: 24px;
		background: rgba(6, 8, 12, 0.78);
		backdrop-filter: blur(6px);
	}
	#paintlab-lightbox.is-open {
		display: flex;
	}
	.paintlab-lb-inner {
