# ============================================================
# 智能多语言翻译
# 复制为 .env（本地）或在 Vercel / 服务器上按同名变量配置。
# 不要加 PUBLIC_ 前缀，否则会暴露到浏览器。
#
# 已启用两个翻译源，都不需要注册、不需要 API Key，
# 访客可以在语言面板顶部的「翻译源」里自行切换（选择会记住）：
#   translatejs —— translate.service 免费通道
#                  https://github.com/xnx3/translate
#   edge        —— 微软 Edge 翻译接口（edge.microsoft.com）
# 下面所有变量都可以不填，不填即可正常工作。
# ============================================================

# 默认翻译源（translatejs / edge），只在访客未手动选择时生效；
# 留空即用内置默认值 edge（微软翻译）
TRANSLATE_PROVIDER=

# 可选：覆盖 translate.service 地址（自建同名接口 / 反向代理时使用）
# TRANSLATE_API_URL=https://api.translate.zvo.cn

# 可选：覆盖微软 Edge 翻译接口地址（反向代理时使用）
# EDGE_TRANSLATE_API_URL=https://edge.microsoft.com/translate/translatetext

# ---------- 术语表与忽略词（服务端处理，前端拿不到）----------
# 追加术语表（JSON）。代码内置的术语表优先级更高，不会被覆盖。
# 例：TRANSLATE_GLOSSARY={"我的博客":"My Blog","DeepSeek":{"en":"DeepSeek"}}
TRANSLATE_GLOSSARY=

# 追加忽略词（逗号分隔），这些词永远不翻译
# 例：TRANSLATE_IGNORE_WORDS=liyueovo,liyueovo.top
TRANSLATE_IGNORE_WORDS=

# ------------------------------------------------------------
# 注意：translate.service 的免费通道有「2 秒内最多 2 次请求」的频率防护，
# 服务端已做串行队列 + 最小间隔 + 失败重试；加上浏览器本地缓存（30 天），
# 小站完全够用。若将来流量变大导致变慢，可以自建 translate.service 并
# 用 TRANSLATE_API_URL 指过去。
# ------------------------------------------------------------
